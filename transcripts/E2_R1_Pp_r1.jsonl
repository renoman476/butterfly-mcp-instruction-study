{"ts": "2026-10-14T06:26:40.045Z", "kind": "tool_use", "id": "toolu_01VoNotFqQyyE7eTwPgHbAuK", "name": "mcp__houdini__execute_python", "input": {"code": "import math\nb=hou.node('/obj/butterfly/CTRL_body')\ndef remap(f):\n    if f<=66: return f\n    if f<=92: return 66+(f-66)*37.0/26\n    if f<=116: return 103+(f-92)*9.0/24\n    if f<=132: return 112+(f-116)*20.0/16\n    return f\ndef rekey(p, newvals):\n    # newvals: dict frame->value; replace keys within [min,max]\n    fr=sorted(newvals); lo,hi=fr[0],fr[-1]\n    p.deleteKeyframes(hou.Keyframe(), ) if False else None\n    for k in p.keyframes():\n        if lo-1e-6<=k.frame()<=hi+1e-6: p.deleteKeyframeAtFrame(k.frame())\n    for f in fr:\n        k=hou.Keyframe(); k.setFrame(f); k.setValue(newvals[f]); k.setExpression(\"linear()\", hou.exprLanguage.Hscript); p.setKeyframe(k)\n# body\nfor c in ('tx','ty','tz','rx','ry','rz'):\n    p=b.parm(c)\n    nv={f: p.evalAtFrame(remap(f)) for f in range(67,132)}\n    rekey(p,nv)\n# wings\nfor w in ('CTRL_wing_L','CTRL_wing_R'):\n    p=hou.node('/obj/butterfly/'+w).parm('flap')\n    old=lambda x,p=p: p.evalAtFrame(x)\n    a=old(107.0); peak=max(old(107+i*0.25) for i in range(0,16))\n    nv={}\n    steps=[92+i*0.25 for i in range(0,61)]  # 92..107\n    for f in steps:\n        if f<=103: nv[f]=old(f+4)\n        else:\n            t=f-103; nv[f]=a+(peak-a)*(1-math.cos(2*math.pi*t/4))/2\n    rekey(p,nv)\nprint('ok')"}}
